# /etc/schedule-spotter-site/site.env  (chmod 600, owned by root)
# Every TODO(Austin) needs a real value before the site goes live.

# The address on the business card's QR code. TODO(Austin)
SITE_URL=https://TODO-Austin-domain.example
# 32+ random characters; signs the download links. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET=
DATA_DIR=/var/lib/schedule-spotter-site
RELEASES_DIR=/srv/schedule-spotter/releases

# How long a link works, and how many fresh downloads it allows.
# TODO(Austin): link lifetime (DECISIONS.md, Phase 6 open items).
LINK_DAYS=7
MAX_DOWNLOADS=5
LINKS_PER_EMAIL_PER_DAY=3
REQUESTS_PER_IP_PER_HOUR=10

# Sending mail from the company address. TODO(Austin): the provider's SMTP
# settings, with SPF and DKIM set up for the domain so links don't land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tight Line <TODO-Austin@TODO-Austin-domain.example>
REPLY_TO=

# Leave empty and the site uses each address only to send its link, then
# forgets it a day after the link expires. Set it to the exact wording of a
# follow-up permission and the form shows it as an opt-in checkbox.
# TODO(Austin): whether Tight Line may follow up, and in what words.
CONSENT_TEXT=

# 1 refuses gmail.com, outlook.com and the like. Off by default: many small
# contractors run their business from one.
COMPANY_DOMAINS_ONLY=0

# Used for the "about N minutes" estimate on the download page.
ASSUMED_MBPS=25
# The one contact line shown at the bottom of every page. TODO(Austin)
CONTACT=
